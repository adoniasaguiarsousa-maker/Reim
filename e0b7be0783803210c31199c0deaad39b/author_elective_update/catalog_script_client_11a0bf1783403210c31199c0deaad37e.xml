        <script><![CDATA[function onLoad() {
    try {
        // Pega o controle (input) do campo spending_date
        var control = g_form.getControl('spending_date');

        if (control) {
            // Define mínimo
            control.setAttribute("min", "1990-01-01");

            // Define máximo = hoje
            var today = new Date().toISOString().split("T")[0];
            control.setAttribute("max", today);
        }

    } catch (e) {
        g_form.addInfoMessage("Erro ao aplicar restrição de datas: " + e.message);
    }
}]]></script>
